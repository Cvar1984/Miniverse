project.manifest = manifest.xml

base.sourcePath = source
base.resourcePath = resources

# Two build-time switches, each keeping one of a pair of annotated functions.
# Budget: watches with half the per-frame budget (a watchdog count of 120000 in
# their simulator profiles) build the (:halfBudget) versions, every other watch
# the (:fullBudget) ones. Colour: the black-and-white watches (1 bit per pixel)
# build the (:mono) versions, every other watch the (:colour) ones.
base.excludeAnnotations = halfBudget;mono
descentg1.excludeAnnotations = fullBudget;colour
enduro.excludeAnnotations = fullBudget;mono
fenix6.excludeAnnotations = fullBudget;mono
fenix6s.excludeAnnotations = fullBudget;mono
fr255.excludeAnnotations = fullBudget;mono
fr255s.excludeAnnotations = fullBudget;mono
instinct2.excludeAnnotations = fullBudget;colour
instinct2s.excludeAnnotations = fullBudget;colour
instinct2x.excludeAnnotations = fullBudget;colour
instinct3solar45mm.excludeAnnotations = halfBudget;colour
instinctcrossover.excludeAnnotations = fullBudget;colour
instincte40mm.excludeAnnotations = halfBudget;colour
instincte45mm.excludeAnnotations = halfBudget;colour
